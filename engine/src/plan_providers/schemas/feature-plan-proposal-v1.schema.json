{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-copilot.dev/schemas/feature-plan-proposal-v1.schema.json",
  "title": "FeaturePlanProposal",
  "description": "Untrusted proposal body generated by an AI plan provider before request-envelope binding.",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_body"],
  "properties": {
    "base_body": {
      "$ref": "#/$defs/baseBody"
    },
    "primitive_bodies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/baseBody"
      }
    },
    "boolean_operations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/booleanOperation"
      }
    },
    "features": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "point2D": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_mm", "y_mm"],
      "properties": {
        "x_mm": {
          "type": "number"
        },
        "y_mm": {
          "type": "number"
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x_mm": {
          "type": "number"
        },
        "y_mm": {
          "type": "number"
        },
        "z_mm": {
          "type": "number"
        }
      }
    },
    "baseBodyDimensions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "length": { "type": "number" },
        "length_mm": { "type": "number" },
        "width": { "type": "number" },
        "width_mm": { "type": "number" },
        "thickness": { "type": "number" },
        "thickness_mm": { "type": "number" },
        "height": { "type": "number" },
        "height_mm": { "type": "number" },
        "radius": { "type": "number" },
        "radius_mm": { "type": "number" },
        "diameter": { "type": "number" },
        "diameter_mm": { "type": "number" },
        "tooth_count": { "type": "integer", "minimum": 3 },
        "module": { "type": "number" },
        "module_mm": { "type": "number" },
        "pressure_angle": { "type": "number" },
        "pressure_angle_deg": { "type": "number" },
        "face_width": { "type": "number" },
        "face_width_mm": { "type": "number" },
        "bore_diameter": { "type": "number" },
        "bore_diameter_mm": { "type": "number" }
      }
    },
    "baseBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "dimensions_mm"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "family": {
          "type": "string",
          "enum": [
            "rectangular_prism",
            "cylinder",
            "sphere",
            "spur_gear",
            "revolved_shaft"
          ]
        },
        "semantic_labels": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 16
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "dimensions_mm": {
          "$ref": "#/$defs/baseBodyDimensions"
        },
        "profile_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point2D"
          },
          "maxItems": 512
        }
      }
    },
    "booleanOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "target_body_id", "tool_body_id", "result_body_id"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "operation": {
          "type": "string",
          "enum": ["union", "subtract", "intersect"]
        },
        "target_body_id": {
          "type": "string",
          "maxLength": 128
        },
        "tool_body_id": {
          "type": "string",
          "maxLength": 128
        },
        "result_body_id": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "targetFaceObject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selector": {
          "type": "string",
          "maxLength": 64
        },
        "resolved_face": {
          "type": "string",
          "maxLength": 16
        },
        "normal_axis": {
          "type": "string",
          "maxLength": 8
        }
      }
    },
    "featureTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body_id": {
          "type": "string",
          "maxLength": 128
        },
        "face": {
          "$ref": "#/$defs/targetFaceObject"
        }
      }
    },
    "centerUV": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "u": {
          "type": "number"
        },
        "v": {
          "type": "number"
        }
      }
    },
    "featurePlacement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "maxLength": 64
        },
        "center_uv_mm": {
          "$ref": "#/$defs/centerUV"
        }
      }
    },
    "featureOrientation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "axis": {
          "type": "string",
          "maxLength": 16
        },
        "angle_deg": {
          "type": "number"
        }
      }
    },
    "featureExtent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "maxLength": 32
        },
        "direction": {
          "type": "string",
          "maxLength": 32
        },
        "depth_mm": {
          "type": "number"
        },
        "distance_mm": {
          "type": "number"
        }
      }
    },
    "featureDimensions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "diameter": { "type": "number" },
        "diameter_mm": { "type": "number" },
        "length": { "type": "number" },
        "length_mm": { "type": "number" },
        "width": { "type": "number" },
        "width_mm": { "type": "number" },
        "height": { "type": "number" },
        "height_mm": { "type": "number" },
        "thickness": { "type": "number" },
        "thickness_mm": { "type": "number" },
        "distance": { "type": "number" },
        "distance_mm": { "type": "number" },
        "depth": { "type": "number" },
        "depth_mm": { "type": "number" },
        "angle_deg": { "type": "number" },
        "radial_depth_mm": { "type": "number" },
        "profile_height_mm": { "type": "number" }
      }
    },
    "featureProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points"],
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point2D"
          },
          "maxItems": 512
        }
      }
    },
    "revolveAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "$ref": "#/$defs/point2D"
        },
        "end": {
          "$ref": "#/$defs/point2D"
        }
      }
    },
    "featureRevolve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis"],
      "properties": {
        "axis": {
          "$ref": "#/$defs/revolveAxis"
        },
        "angle_deg": {
          "type": "number"
        }
      }
    },
    "featurePath": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "maxLength": 32
        },
        "radius_mm": {
          "type": "number"
        },
        "radius": {
          "type": "number"
        },
        "angle_deg": {
          "type": "number"
        }
      }
    },
    "sweepCrossSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["circle", "rectangle", "polygon"]
        },
        "diameter": { "type": "number" },
        "diameter_mm": { "type": "number" },
        "width": { "type": "number" },
        "width_mm": { "type": "number" },
        "height": { "type": "number" },
        "height_mm": { "type": "number" },
        "profile_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point2D"
          },
          "maxItems": 512
        },
        "position": {
          "type": "string",
          "enum": ["start", "end"]
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "family": {
          "type": "string",
          "enum": [
            "circular_through_hole",
            "rectangular_through_cutout",
            "slot_through_cutout",
            "rectangular_extruded_pad",
            "revolved_profile",
            "profile_cutout",
            "swept_protrusion"
          ]
        },
        "target": {
          "$ref": "#/$defs/featureTarget"
        },
        "placement": {
          "$ref": "#/$defs/featurePlacement"
        },
        "orientation": {
          "$ref": "#/$defs/featureOrientation"
        },
        "extent": {
          "$ref": "#/$defs/featureExtent"
        },
        "dimensions_mm": {
          "$ref": "#/$defs/featureDimensions"
        },
        "profile": {
          "$ref": "#/$defs/featureProfile"
        },
        "revolve": {
          "$ref": "#/$defs/featureRevolve"
        },
        "path": {
          "$ref": "#/$defs/featurePath"
        },
        "cross_sections": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/sweepCrossSection"
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "family": {
              "enum": [
                "circular_through_hole",
                "rectangular_through_cutout",
                "slot_through_cutout",
                "rectangular_extruded_pad"
              ]
            }
          },
          "required": ["dimensions_mm"]
        },
        {
          "properties": {
            "family": {
              "const": "profile_cutout"
            }
          },
          "required": ["profile"]
        },
        {
          "properties": {
            "family": {
              "const": "revolved_profile"
            }
          },
          "required": ["revolve"]
        },
        {
          "properties": {
            "family": {
              "const": "swept_protrusion"
            }
          },
          "required": ["cross_sections"]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "family": { "const": "circular_through_hole" }
            }
          },
          "then": {
            "required": ["dimensions_mm"],
            "properties": {
              "dimensions_mm": {
                "anyOf": [
                  { "required": ["diameter"] },
                  { "required": ["diameter_mm"] }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": { "const": "rectangular_through_cutout" }
            }
          },
          "then": {
            "required": ["dimensions_mm"],
            "properties": {
              "dimensions_mm": {
                "allOf": [
                  {
                    "anyOf": [
                      { "required": ["width"] },
                      { "required": ["width_mm"] }
                    ]
                  },
                  {
                    "anyOf": [
                      { "required": ["height"] },
                      { "required": ["height_mm"] },
                      { "required": ["length"] },
                      { "required": ["length_mm"] }
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": { "const": "slot_through_cutout" }
            }
          },
          "then": {
            "required": ["dimensions_mm"],
            "properties": {
              "dimensions_mm": {
                "allOf": [
                  {
                    "anyOf": [
                      { "required": ["length"] },
                      { "required": ["length_mm"] }
                    ]
                  },
                  {
                    "anyOf": [
                      { "required": ["width"] },
                      { "required": ["width_mm"] }
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": { "const": "rectangular_extruded_pad" }
            }
          },
          "then": {
            "required": ["dimensions_mm"],
            "properties": {
              "dimensions_mm": {
                "allOf": [
                  {
                    "anyOf": [
                      { "required": ["width"] },
                      { "required": ["width_mm"] }
                    ]
                  },
                  {
                    "anyOf": [
                      { "required": ["height"] },
                      { "required": ["height_mm"] }
                    ]
                  },
                  {
                    "anyOf": [
                      { "required": ["distance"] },
                      { "required": ["distance_mm"] }
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
