{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-copilot.dev/schemas/edit-request.schema.json",
  "title": "EditRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "kind",
    "session_id",
    "unit",
    "prompt",
    "base_state_revision"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "kind": { "const": "prompt_edit_part" },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "unit": { "const": "mm" },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "base_state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "native_part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "visible_artifacts": { "$ref": "#/$defs/visibleArtifactsPayload" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base64_data", "mime_type"],
      "properties": {
        "base64_data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5242880
        },
        "mime_type": {
          "type": "string",
          "enum": ["image/png", "image/jpeg"]
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": ["desktop_app", "cad_copilot", "local_agent"]
        },
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    }
  },
  "$defs": {
    "visibleArtifactsPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["par", "step", "jpg", "stl"]
          }
        }
      }
    }
  }
}
