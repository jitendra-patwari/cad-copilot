{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-copilot.dev/schemas/generation-request.schema.json",
  "title": "GenerationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "kind", "unit", "prompt"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "kind": { "const": "prompt_to_cad" },
    "unit": { "const": "mm" },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "visible_artifacts": { "$ref": "#/$defs/visibleArtifactsPayload" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base64_data", "mime_type"],
      "properties": {
        "base64_data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5242880
        },
        "mime_type": { "type": "string", "enum": ["image/png", "image/jpeg"] }
      }
    },
    "qa_policy": {
      "type": "string",
      "enum": ["vision_off", "strict_vision", "vision_warning"]
    },
    "vision_qa_model_id": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": ["desktop_app", "cad_copilot", "local_agent"]
        },
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    }
  },
  "$defs": {
    "visibleArtifactsPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["par", "step", "jpg", "stl"]
          }
        }
      }
    }
  }
}
