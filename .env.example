# ==============================================================================
# CAD Copilot Environment Configuration Template
# This file is a naming template for caller-managed process environment variables
# or future session-only UI composition. The engine does NOT load .env files automatically.
# ==============================================================================

# --- Generative AI Provider & Model Configuration ---
# Google Gemini API key used for prompt-to-CAD proposal generation (M4.2 / M4.5).
# Provide via process environment in caller sessions (e.g. $env:GEMINI_API_KEY).
# Not read or required for deterministic example_plan mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifier environment variable for prompt_to_cad requests (defaults to gemini-3.5-flash-lite).
# Must match a valid model ID without leading/trailing whitespace; invalid values fail safely.
CAD_LLM_MODEL=gemini-3.5-flash-lite

# --- Output Directory Root ---
# Required directory where generated CAD models, exports, and manifests are saved.
# Must identify an existing directory; the engine creates per-request subdirectories inside it.
CAD_OUTPUT_ROOT=C:\path\to\existing\output_root
