# ==============================================================================
# CAD Copilot Environment Configuration Template
# Copy this file to .env and populate with your credentials before running.
# ==============================================================================

# --- Generative AI Provider & Dynamic Model Configuration ---
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
CAD_LLM_PROVIDER=google                     # Options: google, openai, mock

# Active model identifier. Currently available Gemini options:
# - gemini-3.7-flash
# - gemini-3.6-flash
# - gemini-3.5-flash
# - gemini-3.5-flash-lite
# - gemini-3.1-flash-lite
# - gemini-3-flash
# - gemini-2.5-flash
# - gemini-2.5-flash-lite
CAD_LLM_MODEL=gemini-3.7-flash

# --- CAD Simulation & Recruiter Mock Mode ---
CAD_MOCK_MODE=0                             # Set to 1 for zero-dependency macOS/Linux simulation
CAD_LICENSE_PUBLIC_KEY=                     # RS256 public key string for batch license verification

# --- Optional Local REST API Server Configuration ---
CAD_CLOUD_SERVER_PORT=8000
CAD_CLOUD_SERVER_HOST=127.0.0.1
CAD_CLOUD_RATE_LIMIT=60                     # Max requests per minute
