# ==============================================================================
# CAD Copilot Environment Configuration Template
# Copy this file to .env and populate with your credentials before running.
# ==============================================================================

# --- Generative AI Provider & Model Configuration ---
# Google Gemini API key used for prompt-to-CAD generation
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# Active Gemini model identifier (e.g. your verified Gemini model)
CAD_LLM_MODEL=your_gemini_model_here

# --- Output Directory Root ---
# Absolute or relative path where generated CAD models, exports, and batches are saved
CAD_OUTPUT_ROOT=./output
